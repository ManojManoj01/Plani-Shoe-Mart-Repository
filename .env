# ==============================================================================
# StepStyle Footwear Store - Environment Variables Template (Supabase / PostgreSQL)
# Copy this file to `.env` or set these variables in your system environment.
# ==============================================================================

# Application Server
SERVER_PORT=8080

# ==============================================================================
# Supabase PostgreSQL Database Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> Database
# ==============================================================================
# Option 1: Individual Database Parameters
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=postgres.rlryucrhtugglzefnwxq
DB_PASSWORD=Manojshoeshop
DB_SSLMODE=require

# Option 2 (Alternative): Full JDBC Connection String
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SUPABASE_DB_USERNAME=postgres.rlryucrhtugglzefnwxq
SUPABASE_DB_PASSWORD=Manojshoeshop

# ==============================================================================
# JWT Authentication Secret
# MUST BE at least 256 bits (32+ alphanumeric characters or base64)
# ==============================================================================
JWT_SECRET=YourSuperSecretKeyForStepStyleJwtSigningMustBeAtLeast32BytesLong123456
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Admin Bootstrap (Default System Administrator)
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Password@123
ADMIN_BOOTSTRAP_EMAIL=admin@stepstyle.com

# File Upload Directory
UPLOAD_DIR=uploads/products

# Email Service Configuration (SMTP)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_smtp_username_here
MAIL_PASSWORD=your_smtp_password_here
MAIL_FROM=noreply@stepstyle.com
MAIL_DEV_MODE=true

# Frontend URL for Password Reset Link
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/reset-password
