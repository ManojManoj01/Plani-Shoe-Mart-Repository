# ==============================================================================
# StepStyle / Show-Shop - Environment Variables Configuration
# Copy this file to `.env` or set these variables in your system environment.
# ==============================================================================

# Application Server
SERVER_PORT=8080

# ==============================================================================
# Option 1: MySQL Database Configuration (Local or Remote MySQL 8.x)
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=show_shop_db
DB_USERNAME=root
DB_PASSWORD=
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://localhost:3306/show_shop_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ==============================================================================
# Option 2 (Alternative): PostgreSQL / Supabase Database Configuration
# To use Supabase or PostgreSQL, uncomment the line below or set SPRING_DATASOURCE_URL:
# ==============================================================================
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.rlryucrhtugglzefnwxq
# SPRING_DATASOURCE_PASSWORD=Manojshoeshop
# SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# JPA Mode (update mode safely preserves existing data and tables)
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
FLYWAY_ENABLED=false

# ==============================================================================
# Admin Bootstrap Configuration (Secure one-time startup seed)
# ==============================================================================
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@stepstyle.com
ADMIN_BOOTSTRAP_PASSWORD=Password@123
ADMIN_BOOTSTRAP_FIRST_NAME=System
ADMIN_BOOTSTRAP_LAST_NAME=Administrator

# ==============================================================================
# JWT Authentication Secret
# MUST BE at least 256 bits (32+ alphanumeric characters or base64)
# ==============================================================================
JWT_SECRET=StepStyleFootwearStoreSecretKeyMustBeAtLeast256BitsLongForHmacSha256Security12345
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Strict local Angular origin)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# File Upload Directory
UPLOAD_DIR=uploads/products

# Email Service Configuration (SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@stepstyle.com
MAIL_DEV_MODE=true

# Frontend URL for Password Reset Link
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/reset-password
