# ==============================================================================
# StepStyle Footwear Store - Environment Variables Configuration Template
# NOTE: Secrets must NEVER be committed to Git or exposed in frontend code!
# ==============================================================================

# Application Server Port
SERVER_PORT=8080

# ==============================================================================
# Supabase PostgreSQL Connection
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection string
# ==============================================================================
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USERNAME=postgres.your_supabase_project_ref
DB_PASSWORD=your_supabase_database_password
DB_SSLMODE=require

# Alternative JDBC Connection String Format
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.your_supabase_project_ref
SUPABASE_DB_PASSWORD=your_supabase_database_password

# ==============================================================================
# Supabase Storage Configuration (Server-Side Only - NEVER expose to frontend)
# ==============================================================================
# Your Supabase Project URL, e.g., https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase secret service-role key with storage write permissions
# Obtain from: Supabase Dashboard -> Project Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Storage Bucket Name for Product Photos
SUPABASE_STORAGE_BUCKET=product-images

# ==============================================================================
# JWT Authentication Secret
# MUST BE at least 256 bits (32+ alphanumeric characters)
# ==============================================================================
JWT_SECRET=YourSuperSecretKeyForStepStyleJwtSigningMustBeAtLeast32BytesLong123456
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ==============================================================================
# CORS Configuration (Allowed Frontend Origins)
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Local File Upload Fallback Directory
UPLOAD_DIR=uploads/products

# Admin Bootstrap (Default System Administrator)
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Password@123
ADMIN_BOOTSTRAP_EMAIL=admin@stepstyle.com
