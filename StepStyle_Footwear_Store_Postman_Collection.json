{
  "info": {
    "_postman_id": "stepstyle-footwear-store-api-collection",
    "name": "StepStyle Footwear Store - REST API Collection",
    "description": "Comprehensive Postman collection covering all endpoints of StepStyle Footwear Store Spring Boot backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminAccessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"sneakerhead99\",\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Morgan\",\n  \"email\": \"alex.morgan@example.com\",\n  \"password\": \"Password@123\",\n  \"confirmPassword\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"john_doe\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set(\"adminAccessToken\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile (/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        },
        {
          "name": "Forgot Password Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_TOKEN_FROM_CONSOLE_OR_EMAIL\",\n  \"newPassword\": \"NewPassword@456\",\n  \"confirmPassword\": \"NewPassword@456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "reset-password"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Products (Public)",
      "item": [
        {
          "name": "Get All Active Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?page=0&size=12&sortBy=price&direction=asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "12" },
                { "key": "sortBy", "value": "price" },
                { "key": "direction", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            }
          }
        },
        {
          "name": "Search Products by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/search?keyword=leather",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "search"],
              "query": [
                { "key": "keyword", "value": "leather" }
              ]
            }
          }
        },
        {
          "name": "Filter by Category",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/category/Chappals",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "category", "Chappals"]
            }
          }
        },
        {
          "name": "Filter Products (Price, Size, Brand)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/filter?minPrice=500&maxPrice=3000&size=UK 8&brand=StepStyle Heritage",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "filter"],
              "query": [
                { "key": "minPrice", "value": "500" },
                { "key": "maxPrice", "value": "3000" },
                { "key": "size", "value": "UK 8" },
                { "key": "brand", "value": "StepStyle Heritage" }
              ]
            }
          }
        },
        {
          "name": "Sort Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/sort?sortBy=price&direction=desc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "sort"],
              "query": [
                { "key": "sortBy", "value": "price" },
                { "key": "direction", "value": "desc" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin Product Management",
      "item": [
        {
          "name": "Create Product (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pro Glide Cushion Slippers\",\n  \"brand\": \"SoleComfort\",\n  \"description\": \"Ultra light EVA cushioned everyday slides with textured anti-skid footbed\",\n  \"price\": 599.00,\n  \"originalPrice\": 899.00,\n  \"category\": \"Slippers\",\n  \"availableSizes\": [\"UK 7\", \"UK 8\", \"UK 9\", \"UK 10\"],\n  \"availableColors\": [\"Charcoal\", \"Navy\", \"Olive\"],\n  \"stockQuantity\": 50,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1560769629-975ec94e6a86\",\n  \"discountPercentage\": 33,\n  \"rating\": 4.6,\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "products"]
            }
          }
        },
        {
          "name": "Update Product (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Traditional Handcrafted Kolhapuri Chappals - Updated Edition\",\n  \"brand\": \"StepStyle Heritage\",\n  \"description\": \"Upgraded top-grain buffalo leather ethnic Kolhapuri chappals with arch cushioning.\",\n  \"price\": 1399.00,\n  \"originalPrice\": 1999.00,\n  \"category\": \"Chappals\",\n  \"availableSizes\": [\"UK 7\", \"UK 8\", \"UK 9\", \"UK 10\", \"UK 11\"],\n  \"availableColors\": [\"Tan\", \"Dark Brown\"],\n  \"stockQuantity\": 60,\n  \"imageUrl\": \"https://images.unsplash.com/photo-1603808033192-082d6919d3e1\",\n  \"discountPercentage\": 30,\n  \"rating\": 4.8,\n  \"active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "products", "1"]
            }
          }
        },
        {
          "name": "Upload Product Image (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/products/1/image",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "products", "1", "image"]
            }
          }
        },
        {
          "name": "Delete Product (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminAccessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "products", "1"]
            }
          }
        }
      ]
    },
