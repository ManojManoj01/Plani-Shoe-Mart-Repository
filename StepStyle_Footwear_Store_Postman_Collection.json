    {
      "name": "7. Contact Enquiries",
      "item": [
        {
          "name": "Submit Contact Enquiry (Public)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.doe@example.com\",\n  \"phone\": \"+91 98765 43210\",\n  \"subject\": \"Size exchange enquiry\",\n  \"message\": \"Hello, I would like to exchange my UK 8 size shoes for UK 9 if available.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/contact",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contact"]
            }
          }
        },
        {
          "name": "Get All Contact Enquiries (Admin Only)",
          "request": {
            "method": "GET",
            "header": [
